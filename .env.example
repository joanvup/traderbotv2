# Copia este archivo a .env y completa solo lo que necesites.
# El modo por defecto es usar la sesión ya abierta del terminal MT5.

# Login programático opcional (nunca se guarda en YAML ni en SQLite)
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# Token obligatorio para comandos de escritura del dashboard (Pausa, Reanudar, Cerrar todo)
DASHBOARD_TOKEN=cambia-este-token
